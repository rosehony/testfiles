import React, { useState } from "react";

function App() {
  const [userId, setUserId] = useState("");
  const [result, setResult] = useState("");

  const handleFetchData = async () => {
    try {
      const response = await fetch(`http://localhost:4000/user?id=${userId}`);
      const data = await response.json();
      if (data.error) {
        setResult(`Error: ${data.error}`);
      } else {
        setResult(`User: ${data.name}, Balance: ${data.balance}`);
      }
    } catch (error) {
      setResult("Error fetching data.");
    }
  };

  return (
    <div style={{ padding: "20px" }}>
      <h1>Vulnerable Web Page Example: SQL Injection</h1>
      <p>
        This app demonstrates a SQL Injection vulnerability by allowing user
        input to directly influence database queries.
      </p>
      <input
        type="text"
        value={userId}
        onChange={(e) => setUserId(e.target.value)}
        placeholder="Enter user ID"
        style={{ padding: "10px", width: "300px" }}
      />
      <button
        onClick={handleFetchData}
        style={{
          marginLeft: "10px",
          padding: "10px 20px",
          backgroundColor: "red",
          color: "white",
          border: "none",
          cursor: "pointer",
        }}
      >
        Fetch User Info
      </button>
      <div
        style={{
          marginTop: "20px",
          padding: "10px",
          border: "1px solid #ccc",
          backgroundColor: "#f9f9f9",
        }}
      >
        <h3>Result:</h3>
        <p>{result}</p>
      </div>
    </div>
  );
}

export default App;
