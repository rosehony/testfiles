import React, { useState } from "react";

const mockDatabase = {
  1: { id: 1, name: "Alice", balance: "$10,000" },
  2: { id: 2, name: "Bob", balance: "$5,000" },
  3: { id: 3, name: "Charlie", balance: "$7,500" },
};

function App() {
  const [userId, setUserId] = useState("");
  const [userInfo, setUserInfo] = useState(null);

  const handleFetchData = () => {
    // Vulnerable code: No authentication or authorization check
    const user = mockDatabase[userId];
    if (user) {
      setUserInfo(user);
    } else {
      setUserInfo({ error: "User not found." });
    }
  };

  return (
    <div style={{ padding: "20px" }}>
      <h1>Vulnerable Web Page Example: IDOR</h1>
      <p>
        This app demonstrates an Insecure Direct Object Reference (IDOR)
        vulnerability by allowing users to access sensitive data without
        proper authentication.
      </p>
      <input
        type="text"
        value={userId}
        onChange={(e) => setUserId(e.target.value)}
        placeholder="Enter user ID (e.g., 1, 2, 3)"
        style={{ padding: "10px", width: "300px" }}
      />
      <button
        onClick={handleFetchData}
        style={{
          marginLeft: "10px",
          padding: "10px 20px",
          backgroundColor: "blue",
          color: "white",
          border: "none",
          cursor: "pointer",
        }}
      >
        Fetch User Info
      </button>
      <div
        style={{
          marginTop: "20px",
          padding: "10px",
          border: "1px solid #ccc",
          backgroundColor: "#f9f9f9",
        }}
      >
        <h3>User Information:</h3>
        {userInfo ? (
          userInfo.error ? (
            <p style={{ color: "red" }}>{userInfo.error}</p>
          ) : (
            <div>
              <p>ID: {userInfo.id}</p>
              <p>Name: {userInfo.name}</p>
              <p>Balance: {userInfo.balance}</p>
            </div>
          )
        ) : (
          <p>Enter a user ID to fetch details.</p>
        )}
      </div>
    </div>
  );
}

export default App;
